# ==========================================
# FLOWLY / OneDesk 이메일 발송 SMTP 설정 (선택 사항)
# ==========================================
# 실제 외부 Gmail/네이버 메일함으로 메일을 수신하시려면
# 아래 발신용 계정 정보를 설정해 주세요.
#
# [Google Gmail 사용 시]
# 1. Google 계정 관리 > 보안 > 2단계 인증 활성화
# 2. '앱 비밀번호(App Password)' 생성 (16자리)
# 3. 아래 SMTP_USER와 SMTP_PASS에 입력
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OneDesk 시스템" <noreply@onedesk.internal>
